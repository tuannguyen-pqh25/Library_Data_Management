# Cấu hình Bảo mật và Server
JWT_SECRET=replace_with_a_long_random_secret
PORT=5000

# Cấu hình Email (Sử dụng cho các chức năng như đặt lại mật khẩu)
EMAIL_USER=your-email@example.com
EMAIL_PASS=replace_with_your_email_app_password
EMAIL_SERVICE=gmail
EMAIL_PORT=587
EMAIL_HOST=smtp.gmail.com

# Cấu hình Database
DB_NAME=library_db
DB_USER=librarymanagement
DB_PASS=librarymanagement
DB_HOST=127.0.0.1
DB_PORT=3306

# Used only by `npm run seed-data` for demo reader accounts.
SEED_READER_PASSWORD=replace_with_a_demo_password_at_least_12_characters
